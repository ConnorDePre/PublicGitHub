{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueryUserActivity",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/UserActivity",
        "arn:aws:dynamodb:*:*:table/UserActivity/index/*"
      ]
    },
    {
      "Sid": "ListBooksPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::digicover-books",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "books/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadBookObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::digicover-books/books/*"
    }
  ]
}
